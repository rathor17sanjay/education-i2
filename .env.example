# Copy to .env and fill in from your password manager. Never commit .env.

# Supabase (Postgres + pgvector + Auth + Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# LLM / embeddings
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# App
ENV=development
